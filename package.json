{
  "name": "blu",
  "version": "0.3.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:mobile": "npm run test -w blu-mobile",
    "test:mobile:security": "vitest run apps/mobile/src/security.contract.test.ts apps/mobile/src/selection.test.ts apps/mobile/src/storage.test.ts apps/mobile/src/version.test.ts",
    "mastg:apk": "node scripts/mastg-apk-assert.mjs",
    "mobile": "npm run start -w blu-mobile",
    "sync:data": "node scripts/sync-blu-core-data.mjs",
    "eval:security": "vitest run src/lib/assistant/redteam.test.ts",
    "smoke:api": "node scripts/smoke-api.mjs"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.77.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "blu-core": "*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^31.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
