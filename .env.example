# Variables de ENTORNO de Blu — plantilla de referencia (no introducir valores reales aquí).
# Copia a .env.local para desarrollo (ignorado por Git) o configúralas como variables
# server-side en Vercel. NUNCA uses prefijo NEXT_PUBLIC_ para claves (ADR-0005, BLU-1403).

# --- Chat remoto con IA (ADR-0005) ---
# Proveedor OpenAI-compatible (GroqCloud free tier, OpenAI, Azure OpenAI…).
# Sin estas tres variables, Blu responde con reglas locales deterministas.
# BLU_LLM_BASE_URL=https://api.groq.com/openai/v1
# BLU_LLM_API_KEY=
# BLU_LLM_MODEL=openai/gpt-oss-120b

# --- Piloto cerrado (opcional) ---
# Si está definida, /api/assistant exige Authorization: Bearer <token>.
# El rate limit usa el IP de borde (x-vercel-forwarded-for / último hop de XFF).
# BLU_API_TOKEN=

# --- V1: cuentas y sincronización (ADR-0006; activación SOLO con estas variables) ---
# La anon key es pública por diseño: la seguridad la pone RLS owner-only (specs/009).
# Sin estas variables, Blu sigue 100% local y la ruta /cuenta muestra aviso honesto.
# Activación en producción exige firmas C1-C3/C5 de ADR-0006 (EIPD, contrato+región, pentest).
# SUPABASE_URL=https://proyecto.supabase.co
# SUPABASE_ANON_KEY=

# --- V2: memoria conversacional opt-in (ADR-0008 D-1, #43) ---
# Apagada salvo "1". Requiere además V1 (arriba), sesión y consentimiento
# «memoria_conversacional». NO activar con datos reales sin D1 (EIPD-V2) y D2
# (V1 activo). Migración: supabase/migrations/0003_conversation_memory.sql;
# programar memory_purge() a diario con service_role.
# BLU_MEMORY_ENABLED=0

# --- Voz natural ElevenLabs (preferida; solo servidor) ---
# La CLI `npx @elevenlabs/cli onboard init` deja la clave en .env.local (ignorado por git).
# Nunca uses NEXT_PUBLIC_ para esta clave.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_v4

# --- Voz neuronal Azure TTS F0 (opcional, excepción ADR-0003) ---
# Requiere recurso Azure Speech nivel F0 verificado manualmente. Desactivado por defecto.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# AZURE_SPEECH_LOCALE=es-CL
# AZURE_SPEECH_VOICE=es-CL-CatalinaNeural
# AZURE_SPEECH_F0_CONFIRMED=true
# AZURE_SPEECH_ENABLED=true
